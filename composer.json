{
    "name": "nawar16/lite-feature-flag-bundle",
    "description": "A lightweight Symfony Feature Flag bundle focused on developer workflow",
    "autoload": {
        "psr-4": {
            "Nawar16\\LiteFeatureFlagBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nawar16\\LiteFeatureFlagBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "nawar16",
            "email": "nawarmk98@gmail.com"
        }
    ],
    "require": {
        "symfony/http-kernel": "^7.4",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/console": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^8.1"
    }
}
